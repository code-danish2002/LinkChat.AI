# ---- Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# "production" makes the server warn about missing secrets.
ENVIRONMENT=development

# ---- Database (required) -----------------------------------------------
# Postgres with the pgvector extension. Neon's free tier works and needs no
# card: https://neon.tech. Use the POOLED connection string (host contains
# "-pooler"). The schema in backend/db/schema.postgres.sql is applied on
# every start, so a fresh database needs no manual setup.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Identity -----------------------------------------------------------
# Guests are a browser-generated id; their sources are deleted this long
# after their last request. Users sign in with an emailed code; a session
# lasts SESSION_TTL_HOURS and is extended on use.
# AUTH_SECRET hashes codes and session tokens. Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Leaving it empty works for local development but every restart signs
# everyone out.
AUTH_SECRET=
GUEST_TTL_HOURS=24
SESSION_TTL_HOURS=168
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# ---- Email (login codes) -------------------------------------------------
# console: the code is printed to the server log and returned to the UI (local only).
# resend:  real email through https://resend.com (free tier, no card). Set the key,
#          and a sender on a domain you verified there, or Resend's test sender
#          which can only deliver to your own address.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="LinkChat <onboarding@resend.dev>"

# ---- Model providers ---------------------------------------------------
# Only providers with a key (or explicitly enabled) join the failover pool.
# Add at least one. Groq and Cerebras have generous free tiers; OpenRouter
# lists many ":free" open-weight models.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=

# Google AI Studio: free tier, no payment card at the time of writing. Serves
# Gemma, Google's open-weight family. Key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Mistral: free tier on https://console.mistral.ai (phone verification).
MISTRAL_API_KEY=

# Ollama Cloud: hosted models, nothing to download. Create a key at
# https://ollama.com/settings/keys after signing in.
OLLAMA_API_KEY=

# Local Ollama: runs on your own machine, no key and no rate limit, but you
# download each model and it is slower. Install from https://ollama.com, then
#   ollama pull llama3.1:8b
# These two are independent; enabling one does not require the other.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Embeddings (local, open-source, via fastembed) ---------------------
# These run on your own CPU: no key, no per-use cost, nothing leaves the machine.
# Tried in order; the first that loads is used, then cached.
#
# The default is multilingual, so questions in Hindi, Spanish or French find
# answers in English sources. Measured on 2026-10-17:
#   mpnet-base-v2   cross-language 5/5, English top1 7/8   768 dim, 1.0 GB
#   MiniLM-L12-v2   cross-language 5/5, English top1 6/8   384 dim, 0.22 GB
#   bge-small-en    cross-language 3/5, English top1 6/8   384 dim, 0.07 GB
#
# Leave this unset to use the default. For the smallest possible download at the
# cost of non-English questions, use the English-only model instead:
# EMBEDDING_MODELS=BAAI/bge-small-en-v1.5
#
# Changing this invalidates existing indexes. Sources rebuild automatically when
# re-submitted, and open conversations report that a Re-read is needed.

# ---- Concurrency and rate limits ---------------------------------------
# Each in-flight ingestion costs roughly 32 MB and 16 seconds of CPU for a long
# article. Submissions queue behind this rather than starting all at once.
MAX_CONCURRENT_INGESTIONS=4
# Per client address, per minute. 0 disables a bucket.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5

# ---- Ingestion / retrieval / chat --------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
MAX_HISTORY_MESSAGES=8
MAX_UPLOAD_BYTES=41943040
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=60
